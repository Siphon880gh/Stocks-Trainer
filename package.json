{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3001 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0 --strictPort --port ${PORT:?PORT is required}",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:coaching": "tsx --test src/lib/coaching/coaching.test.ts",
    "test:financials": "tsx --test \"src/lib/financials/**/*.test.{ts,tsx}\"",
    "test:macro": "tsx --test \"src/lib/macro/**/*.test.{ts,tsx}\"",
    "check:macro-sources": "tsx src/lib/macro/checkSources.ts",
    "test:lib": "tsx --test \"src/lib/*.test.{ts,tsx}\"",
    "test:content": "tsx --test src/lib/contentGraph.test.ts",
    "check:build": "vite build --outDir /tmp/st-build-check --emptyOutDir && rm -rf /tmp/st-build-check",
    "verify": "npm run lint && npm run test:coaching && npm run test:lib && npm run test:financials && npm run test:macro && npm run check:build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
